FROM node:22-bookworm-slim

ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/scan-tools/bin:${PATH}"

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv \
  && rm -rf /var/lib/apt/lists/* \
  && python3 -m venv /opt/scan-tools \
  && /opt/scan-tools/bin/pip install --no-cache-dir bandit semgrep

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src ./src

CMD ["node", "src/workers/scanWorker.js"]
