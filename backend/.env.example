NODE_ENV=development
PORT=5000
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
SESSION_SECRET=

GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/github/callback

# Optional hosted AI. Keep the key server-side; never use a VITE_ variable.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_DIMENSIONS=2048
NVIDIA_CONNECTION_TIMEOUT_MS=30000
NVIDIA_RESPONSE_TIMEOUT_MS=60000
NVIDIA_MAX_RETRIES=2
NVIDIA_MAX_TOKENS=2048
