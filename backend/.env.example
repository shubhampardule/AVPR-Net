NODE_ENV=development
PORT=5000
DATABASE_URL=
# Optional comma-separated DNS servers for MongoDB SRV lookups on restricted networks.
MONGODB_DNS_SERVERS=
# Optional local BullMQ queue; omit to run scans inline during development. Production uses Vercel Queues.
REDIS_URL=
# Optional: run local scanner executables from an isolated WSL distribution on Windows.
# Install the versions pinned in Dockerfile.worker and point this at the WSL venv's bin directory.
SECUREPATCH_SCANNER_WSL_DISTRO=
SECUREPATCH_SCANNER_WSL_BIN_DIR=
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# Set true only for the local synthetic demo. `npm run demo` enables it itself.
SECUREPATCH_DEMO_MODE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local callback defaults; production callback URIs are documented in README.md.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
SESSION_SECRET=
FRONTEND_URL=http://localhost:5174

GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Accepts a local PEM path or the PEM contents with escaped \n characters (for Vercel).
GITHUB_PRIVATE_KEY=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
GITHUB_WEBHOOK_SECRET=
# Optional explicit public receiver URL; otherwise derived from HTTPS FRONTEND_URL.
GITHUB_WEBHOOK_URL=

# Optional invitation emails. Disabled by default; each send also requires a user action.
# Resend requires a verified sending domain. Provider acceptance is not inbox delivery.
INVITATION_EMAIL_ENABLED=false
RESEND_API_KEY=
INVITATION_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Optional hosted AI. Keep the key server-side; never use a VITE_ variable.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_DIMENSIONS=2048
NVIDIA_CONNECTION_TIMEOUT_MS=30000
NVIDIA_RESPONSE_TIMEOUT_MS=60000
NVIDIA_MAX_RETRIES=2
NVIDIA_MAX_TOKENS=2048
# Optional comma-separated subset of python,javascript,typescript,c,cpp,bash.
AI_LANGUAGES=
